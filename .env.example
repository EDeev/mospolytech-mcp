# PostgreSQL сервера
DATABASE_URL=

# Ключ шифрования токенов ЛК в БД (Fernet). Сгенерировать: python -m mospolytech_mcp.crypto
# Сменили ключ — старые токены не расшифруются, пользователям придётся войти заново.
MCP_SECRET_KEY=

# Режим stdio (локально, один пользователь): вход в ЛК без вызова lk_login.
# Лучше персональный ключ из lk_login — тогда пароль не лежит в файле.
MPU_API_KEY=
MPU_LOGIN=
MPU_PASSWORD=
# HTTP-режим, личный сервер (например, для Davi): если ЛК отверг сессию владельца MPU_LOGIN — войти заново
# по MPU_LOGIN/MPU_PASSWORD самому, без участия пользователя. Для остальных пользователей пароль не хранится.
LK_AUTO_RELOGIN=

# Адрес сервера снаружи — для подсказки с настройками на странице /login (режим --http)
MCP_PUBLIC_URL=

# Срок кэша списка групп, минуты (по умолчанию 15)
GROUPS_TTL_MINUTES=

# docker compose
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
